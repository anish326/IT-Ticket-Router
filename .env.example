# ==============================================================================
# AI Ticket Intelligence Platform — Environment Configuration
# ==============================================================================

# Flask Session & Security Configuration
# Set a unique, high-entropy secret key in production for signing session cookies
FLASK_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string-for-production
FLASK_ENV=production

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Database Persistence
# For local development: Leave blank to use SQLite at api/ticket_intelligence.db
# For Vercel Serverless: Automatically routed to writable /tmp/ticket_intelligence.db
# Optional custom SQLite path:
# DB_PATH=./api/ticket_intelligence.db

# Bootstrap Initial Credentials (Optional Override)
# Leave blank to use defaults (admin/admin123, reviewer/reviewer123, agent/agent123)
# ADMIN_PASSWORD=your_secure_admin_password
# REVIEWER_PASSWORD=your_secure_reviewer_password
# AGENT_PASSWORD=your_secure_agent_password
